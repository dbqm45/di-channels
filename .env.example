# Copy to .env (not committed); npm start reads it when it exists. See slack-setup.md.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
CI_CHANNELS_SIGNING_SECRET=
DI_DEFINITION_URL=http://127.0.0.1:4317
# "Waiting for you" from DI Decision (step 17): both or neither
# PDI_CHANNELS_SIGNING_SECRET=
# DI_CHANNELS_APPROVER=U...
# DI_CHANNELS_TIMEZONE=Europe/Warsaw
# SLACK_TEAM_ID=
# DI_CHANNELS_WORKSPACES=
# PORT=3100
# Suite person as the author of questions (ADR 17): all three or none. The secret is that of the di-channels client
# in the suite realm (Keycloak admin console → Clients → di-channels → Credentials); Slack scopes users:read and
# users:read.email are needed (slack-setup.md).
# SUITE_ISSUER=http://localhost:8180/realms/suite
# SUITE_CLIENT_SECRET=
# DI_IDENTITY_URL=http://127.0.0.1:3200
